{
  "metadata": [
    {
      "src": [
        {
		  "src": "../src",
          "files": [
            "**/*.csproj"
          ],
          "exclude": [
            "**/bin/**",
            "**/obj/**",
            "**/*Tests*/**",
            "**/*Benchmark*/**",
            "**/*Example*/**"
          ]
        }
      ],
      "dest": "api",
      "filter": "filterConfig.yml",
      "properties": {
        "TargetFramework": "net10.0-windows"
      }
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "api/**.md",
          "api/**.yml",
          "articles/**.md",
          "ai/**.md",
          "articles/**/toc.yml",
          "toc.yml",
          "*.md"
        ],
        "exclude": [
          "_site/**",
		  "README.md"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "images/**"
        ]
      }
    ],
    "dest": "_site",
	"globalMetadata": {
		"_appTitle": "Dapplo.Windows",
		"_appLogoPath": "images/d.svg",
		"_appFaviconPath": "images/favicon.ico",
		"_appFooter": "Copyright © 2016-2026 Dapplo",
		"_enableSearch": true
	},
    "globalMetadataFiles": [],
    "template": [
      "default",
      "modern"
    ],
    "fileMetadataFiles": [],
    "postProcessors": [],
    "noLangKeyword": false
  }
}