<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Dapplo.Windows.Citrix answers questions about the Citrix session the current process runs in, through the WinFrame API (WFAPI / WFAPI64): is it an ICA session, the client name, address and display, session times and events.</Description>
    <PackageTags>windows native citrix</PackageTags>
    <TargetFrameworks>net480;net10.0-windows</TargetFrameworks>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Dapplo.Log" Version="3.0.22" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Dapplo.Windows.Common\Dapplo.Windows.Common.csproj" />
  </ItemGroup>
</Project>
