<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net480;net10.0-windows</TargetFrameworks>
    <!-- xunit.v3 test projects are executables -->
    <OutputType>Exe</OutputType>
    <!-- The tests use process wide resources (clipboard, hooks, the desktop), so the target frameworks must not run in parallel -->
    <TestTfmsInParallel>false</TestTfmsInParallel>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <!-- Per-monitor DPI awareness and comctl32 v6 for both target frameworks, the app.config DpiAwareness setting only applies to WinForms on .NET Framework -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WFO0003: the test runner generates Main, so Application.SetHighDpiMode can't be used, the manifest is the only way to set the DPI awareness before any window exists -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <!-- coverlet resolves the referenced assemblies from the deps.json compile context, without it System.Drawing.Common
         (from the WindowsDesktop framework) can't be resolved while instrumenting -->
    <PreserveCompilationContext>true</PreserveCompilationContext>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Dapplo.Windows.Advapi32\Dapplo.Windows.Advapi32.csproj" />
    <ProjectReference Include="..\Dapplo.Windows.AppRestartManager\Dapplo.Windows.AppRestartManager.csproj" />
    <ProjectReference Include="..\Dapplo.Windows.Automation\Dapplo.Windows.Automation.csproj" />
    <ProjectReference Include="..\Dapplo.Windows.Citrix\Dapplo.Windows.Citrix.csproj" />
    <ProjectReference Include="..\Dapplo.Windows.Clipboard\Dapplo.Windows.Clipboard.csproj" />
    <ProjectReference Include="..\Dapplo.Windows.Common\Dapplo.Windows.Common.csproj" />
    <ProjectReference Include="..\Dapplo.Windows.Com\Dapplo.Windows.Com.csproj" />
    <ProjectReference Include="..\Dapplo.Windows.DesktopWindowsManager\Dapplo.Windows.DesktopWindowsManager.csproj" />
    <ProjectReference Include="..\Dapplo.Windows.Devices\Dapplo.Windows.Devices.csproj" />
    <ProjectReference Include="..\Dapplo.Windows.Dialogs\Dapplo.Windows.Dialogs.csproj" />
    <ProjectReference Include="..\Dapplo.Windows.Dpi\Dapplo.Windows.Dpi.csproj" />
    <ProjectReference Include="..\Dapplo.Windows.Gdi32\Dapplo.Windows.Gdi32.csproj" />
    <ProjectReference Include="..\Dapplo.Windows.Icons\Dapplo.Windows.Icons.csproj" />
    <ProjectReference Include="..\Dapplo.Windows.Input\Dapplo.Windows.Input.csproj" />
    <ProjectReference Include="..\Dapplo.Windows.Kernel32\Dapplo.Windows.Kernel32.csproj" />
    <ProjectReference Include="..\Dapplo.Windows.InstallerManager\Dapplo.Windows.InstallerManager.csproj" />
    <ProjectReference Include="..\Dapplo.Windows.Messages\Dapplo.Windows.Messages.csproj" />
    <ProjectReference Include="..\Dapplo.Windows.Multimedia\Dapplo.Windows.Multimedia.csproj" />
    <ProjectReference Include="..\Dapplo.Windows.Shell32\Dapplo.Windows.Shell32.csproj" />
    <ProjectReference Include="..\Dapplo.Windows.User32\Dapplo.Windows.User32.csproj" />
    <ProjectReference Include="..\Dapplo.Windows\Dapplo.Windows.csproj" />
    <ProjectReference Include="..\Dapplo.Windows.SystemState\Dapplo.Windows.SystemState.csproj" />
    <ProjectReference Include="..\Dapplo.Windows.Forms\Dapplo.Windows.Forms.csproj" />
    <ProjectReference Include="..\Dapplo.Windows.Wpf\Dapplo.Windows.Wpf.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="Samples\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Reactive" Version="7.0.0" />
    <PackageReference Include="Dapplo.Log.Loggers" Version="3.0.22" />
    <PackageReference Include="Dapplo.Log.XUnit" Version="3.0.22" />
    <PackageReference Include="xunit.analyzers" Version="2.2.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- xunit.v3 4 contains Microsoft.Testing.Platform v2, which no longer runs through the VSTest mode of dotnet test on the .NET 10 SDK.
         The mtp-off variant keeps VSTest (dotnet test with filters, trx and coverlet, Visual Studio Test Explorer via xunit.runner.visualstudio) -->
    <PackageReference Include="xunit.v3.mtp-off" Version="4.0.2" />
    <PackageReference Include="Xunit.StaFact" Version="4.0.24" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.msbuild" Version="10.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
